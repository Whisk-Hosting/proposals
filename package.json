{
  "name": "whisk-proposals",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "node build.mjs && node --enable-source-maps dist/index.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "deploy:demo": "node demo/deploy.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@sentry/node": "^11.6.0",
    "hono": "^4.13.13",
    "inngest": "^4.22.0",
    "marked": "^18.1.0",
    "pino": "^10.4.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
